# Config
PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5433
DB_USER=admin
DB_PASSWORD=admin
DB_NAME=control_pesaje

# Auth
JWT_SECRET=your_super_secret_jwt_key_here

# Balanza flow alerts
# Discord webhook for operator alerts (secret; leave empty to only log alerts to the backend log)
DISCORD_WEBHOOK_URL=
# Alert when an operator session is active but no balanza frames are accepted for this many ms
BALANZA_SILENCE_ALERT_MS=120000
# Minimum ms before re-alerting a línea that keeps failing
BALANZA_ALERT_COOLDOWN_MS=1800000
